# =========================
# Application & LLM
# =========================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openai/gpt-oss-20b

# Comma-separated deployed frontend URLs allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# =========================
# PostgreSQL & pgvector
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatboard
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# =========================
# Embeddings
# =========================
# Default is sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =========================
# Web Search Tool (Optional)
# Supported providers: duckduckgo (default, no key required), tavily, brave, serpapi, google, searxng
# =========================
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_URL=
WEB_SEARCH_ENGINE_ID=

# =========================
# URL Reader Tool (Optional)
# =========================
URL_READER_TIMEOUT=10
URL_READER_MAX_BYTES=5000000
